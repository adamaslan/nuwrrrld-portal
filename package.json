{
  "name": "nuwrrrld-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/db-migrate.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run --project unit --project components",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run __tests__/signal-queue.integration.test.ts",
    "test:live": "vitest run --project live",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preflight": "playwright test --project=preflight",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:login": "rm -f playwright/.auth/user.json && playwright test --project=auth-setup --headed",
    "test:e2e:nulogdash": "playwright test; node scripts/nulogdash-merge-e2e.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:hydrate:dev": "node --env-file=.env.local scripts/hydrate-dev.mjs",
    "nulogdash:inventory": "node scripts/nulogdash-inventory.mjs",
    "nulogdash": "npm run nulogdash:inventory && node --env-file=.env.local scripts/nulogdash.mjs",
    "stash:status": "node scripts/stash-status.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.2",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.7.6",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.26.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-intersection-observer": "^10.1.0",
    "stripe": "^22.2.1",
    "svix": "^1.95.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.24",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
